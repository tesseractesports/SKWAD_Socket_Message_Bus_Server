{
  "name": "socketio-message-bus-server",
  "version": "1.0.0",
  "description": "A stateless, horizontally-scalable Socket.io Message Bus Server for routing real-time messages between Extractors, Transformers, and Consumers",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "socket.io",
    "message-bus",
    "real-time",
    "pub-sub",
    "microservice"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "socket.io": "^4.7.2",
    "socket.io-redis": "^6.1.1",
    "ioredis": "^5.3.2",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
